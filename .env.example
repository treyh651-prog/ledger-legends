# Copy to .env for local work. Never commit .env. Values come from the
# operator; nothing in this repository prints or stores them.
#
# Leave everything unset to run on a developer machine with the in memory
# store and sign in off. Set DATABASE_URL and the four Supabase values to run
# against the real project; docs/RUNNING.md walks through each one.

# Postgres, transaction pooler form. Contains the password.
DATABASE_URL=

# postgres | memory. Unset means Postgres in production, memory otherwise.
# RUN_DB=

# Supabase Auth. All four are required when the database is Postgres.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:5000

# Document storage uses SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above.
# Optional: ceiling per file in bytes (default 25 MiB) and the bucket name.
UPLOAD_MAX_BYTES=26214400
DOCUMENT_BUCKET=documents

# Role for actor transactions. app_web once migration 0023 is applied.
APP_DB_ROLE=app_web
